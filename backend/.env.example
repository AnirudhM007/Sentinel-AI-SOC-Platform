# ==============================================================================
# SENTINEL AI - BACKEND CONFIGURATION (.env)
# ==============================================================================

# Core Settings
PROJECT_NAME="SENTINEL AI"
HOST="127.0.0.1"
PORT=8008
DATABASE_URL="sqlite:///./sentinel.db"
MAX_UPLOAD_SIZE_MB=10

# AI / LLM Configuration
# Set MOCK_MODE=True to run 100% locally with zero API keys or costs.
# Set MOCK_MODE=False and LLM_PROVIDER="openai" to use live OpenAI models.
MOCK_MODE=True
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Threat Intelligence APIs (Optional)
# If left empty, Sentinel AI uses its realistic local threat intelligence database.
ABUSEIPDB_API_KEY=""
VIRUSTOTAL_API_KEY=""

# Deterministic Detection Engine Thresholds
BRUTE_FORCE_THRESHOLD=5
TIME_WINDOW_MINUTES=15
